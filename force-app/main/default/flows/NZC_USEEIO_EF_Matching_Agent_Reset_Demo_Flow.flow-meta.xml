<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>addtocollection</name>
        <label>addtocollection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>s3pistoupdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>for_all_s3pis</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>for_all_s3pis</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>update_fields</name>
        <label>update fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>for_all_s3pis.PcmtEmssnFctrSetItemId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>for_all_s3pis.Match_Reasoning__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>for_all_s3pis.Match_Confidence_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>for_all_s3pis.Review_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>addtocollection</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <description>Flow to reset data for USEEIO matching agent in demo orgs.</description>
    <environments>Default</environments>
    <interviewLabel>NZC USEEIO EF Matching Agent Reset Demo Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NZC USEEIO EF Matching Agent Reset Demo Flow</label>
    <loops>
        <name>for_all_s3pis</name>
        <label>for all s3pis</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_all_S3PIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>update_fields</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_record_collection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_all_S3PIs</name>
        <label>Get all S3PIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>for_all_s3pis</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProcurementSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordid</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Scope3PcmtItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_procurement_summary</name>
        <label>update procurement summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_S3PIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordid</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Bulk_Matching_Cache_Hits__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Completed_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Deduplicated__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Items_Matched__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Items_Needing_Review__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Items_Processed__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Job_Id__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_LLM_Calls__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Bulk_Matching_Status__c</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsComplete</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Scope3PcmtSummary</object>
    </recordUpdates>
    <recordUpdates>
        <name>update_record_collection</name>
        <label>update record collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>s3pistoupdate</inputReference>
    </recordUpdates>
    <screens>
        <name>demoreset</name>
        <label>demoreset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>update_procurement_summary</targetReference>
        </connector>
        <fields>
            <name>display</name>
            <fieldText>&lt;p&gt;Click reset below to clear the S3PIs related to this record to re-test the USEEIO Matching agent&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Reset</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>demoreset</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>s3pistoupdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Scope3PcmtItem</objectType>
    </variables>
</Flow>
